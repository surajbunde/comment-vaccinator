{
  "name": "comment-vaccinator",
  "version": "1.4.0",
  "description": "YouTube comment filter extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.cjs",
    "validate": "node validate.cjs",
    "test": "node --test tests/**/*.test.js",
    "test:legacy": "node test-date-filter.js",
    "test:e2e": "npm run test:e2e:chrome && npm run test:e2e:firefox",
    "test:e2e:chrome": "node tests/e2e/chrome-extension.test.mjs",
    "test:e2e:firefox": "node tests/e2e/firefox-extension.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.20.0"
  }
}
